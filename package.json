{
  "name": "@kabxx/dsh-session-delete",
  "version": "0.1.0",
  "description": "Permanently delete sessions from the context menu in DeepSeek Harness.",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kabxx/dsh-session-delete.git"
  },
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "src/",
    "cordis.patch.yml",
    "locale/",
    "icon.svg"
  ],
  "scripts": {
    "check": "for f in src/*.js; do node --check \"$f\"; done",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": "0.2.2-rc.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
