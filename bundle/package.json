{
  "name": "@kabxx/dsh-session-delete",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "description": "Permanently delete DSH sessions from the right-click menu after confirmation.",
  "engines": {
    "dsh": "0.2.2-rc.5"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "delete.js", "delete-tree.js", "idle-web-writer.js", "delete-disk.js", "disk-trash.js", "online-disk.js", "stale-projection.js", "stale-search.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-workspace"]
    }
  }
}
